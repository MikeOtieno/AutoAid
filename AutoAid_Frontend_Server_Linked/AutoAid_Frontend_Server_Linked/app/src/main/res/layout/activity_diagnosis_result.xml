<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView android:text="Detected Problem" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvProblem"
        android:textSize="18sp"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:text="Confidence" android:textStyle="bold"
        android:layout_marginTop="14dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvConfidence"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:text="Urgency" android:textStyle="bold"
        android:layout_marginTop="14dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvUrgency"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:text="Recommended Action" android:textStyle="bold"
        android:layout_marginTop="14dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvAction"
        android:layout_marginTop="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFindMechanics"
        android:text="Find Nearby Mechanics"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
